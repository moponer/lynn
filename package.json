{
  "name": "lynn",
  "productName": "Lynn",
  "private": true,
  "version": "0.0.2",
  "description": "风铃 Lynn — 本地优先、插件化的桌面 AI 个人助理（指挥者形态）。薄壳 + Pi 运行时 + 三档插件 + MCP。",
  "author": "Monlin <1318686166@qq.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.19.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "undici": "^8.12.3",
    "minimatch": "^11.0.3"
  },
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.main.json",
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json && node scripts/copy-assets.mjs",
    "build": "npm run typecheck && npm run build:renderer && npm run build:main",
    "test": "npm run build:main && node --test --test-force-exit tests/",
    "test:fast": "npm run build:main && node scripts/split-tests.mjs fast",
    "test:slow": "npm run build:main && node scripts/split-tests.mjs slow",
    "prestart": "npm run build:renderer && npm run build:main",
    "start": "electron .",
    "dev": "npm run build && electron .",
    "shot": "electron scripts/preview-shot.cjs",
    "dist": "npm run build && electron-builder --win --config electron-builder.yml",
    "dist:cn": "node scripts/dist-cn.mjs",
    "perf:standby": "electron scripts/perf-run.cjs 60",
    "lint:design": "node scripts/check-design.mjs",
    "lint": "oxlint src --deny-warnings",
    "verify": "npm run typecheck && npm run lint && npm run lint:design && npm test",
    "probe:usage": "electron scripts/live-usage-probe.cjs",
    "probe:pi": "electron scripts/live-pi-usage-probe.cjs",
    "probe:ui": "electron scripts/live-ui-smoke.cjs",
    "check:pi-base": "node scripts/check-pi-base.mjs",
    "live-check": "npm run build:main && electron scripts/live-check.cjs",
    "copy:size": "node scripts/copy-size.mjs",
    "bench:score": "node scripts/bench/score.mjs",
    "bench:tool-usage": "node scripts/bench/tool-usage.mjs",
    "build:native": "node scripts/build-sandbox.mjs",
    "avatars:gen": "node scripts/gen-avatars.mjs",
    "avatars:check": "node scripts/gen-avatars.mjs --check",
    "probe:sandbox": "node scripts/probe-sandbox.mjs",
    "bench:golden": "node scripts/bench/golden.mjs",
    "prompts:sync": "node scripts/prompts/vendor-sync.mjs",
    "prompts:compile": "node scripts/prompts/compile.mjs --all",
    "lint:prompts": "node scripts/prompts/vendor-sync.mjs --check && node scripts/prompts/compile.mjs --all",
    "bench:golden:write": "node scripts/bench/golden.mjs --write",
    "probe:prompt-size": "node scripts/prompt-size.mjs",
    "probe:tool-size": "node scripts/tool-surface-size.mjs",
    "bench:baseline": "node scripts/bench/score.mjs --since 2026-11-16T04:20 --until 2026-11-16T10:00 --out bench/baseline.json",
    "bench:fixtures": "node bench/fixtures/make.mjs",
    "verify:acceptance": "node scripts/acceptance.mjs",
    "lint:i18n": "node scripts/lint-i18n.mjs",
    "check:plugin": "node scripts/check-plugin-package.mjs",
    "check:docs": "node scripts/check-docs-links.mjs",
    "probe:im": "node scripts/probe-im-bridge.mjs",
    "check:feishu": "node scripts/check-feishu.mjs",
    "feishu:admin": "node scripts/run-electron.cjs scripts/feishu-admin.cjs",
    "feishu:watch": "node scripts/run-electron.cjs scripts/feishu-watch-identity.cjs"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.4.0",
    "@earendil-works/pi-ai": "1.4.0",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "diff": "^9.0.0",
    "electron-updater": "^6.8.11",
    "execa": "^8.0.1",
    "iconv-lite": "^0.7.3",
    "jiti": "^2.7.0",
    "node-edge-tts": "1.2.12",
    "node-screenshots": "^0.2.8",
    "pdfjs-dist": "^6.5.438",
    "playwright-core": "^1.64.1"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.3",
    "@dicebear/core": "^9.4.3",
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@js-preview/excel": "^1.7.14",
    "@types/node": "^22.5.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "docx-preview": "^0.4.1",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "highlight.js": "^11.12.0",
    "oxlint": "^1.93.0",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  },
  "optionalDependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "ws": "^8.22.1",
    "@tencent-connect/qqbot-nodejs": "^1.0.4",
    "@wecom/aibot-node-sdk": "^1.0.7",
    "dingtalk-stream": "^2.1.4",
    "qrcode": "^1.5.4"
  }
}
